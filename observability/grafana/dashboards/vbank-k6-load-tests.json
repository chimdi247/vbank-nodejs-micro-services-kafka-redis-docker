{
  "uid": "vbank-k6-load-tests",
  "title": "VBank k6 Load Tests",
  "description": "Live results of the performance tests in /tests (smoke, load, stress, spike, soak, breakpoint, saga-latency) next to container, Kafka and database metrics.",
  "tags": [
    "vbank",
    "k6",
    "performance"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "editable": true,
  "graphTooltip": 1,
  "refresh": "10s",
  "time": {
    "from": "now-30m",
    "to": "now"
  },
  "links": [
    {
      "title": "Platform overview",
      "type": "link",
      "url": "/d/vbank-platform-overview",
      "icon": "dashboard"
    }
  ],
  "templating": {
    "list": [
      {
        "name": "testid",
        "label": "Test",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "query": {
          "query": "label_values(k6_vus, testid)",
          "refId": "t"
        },
        "definition": "label_values(k6_vus, testid)",
        "refresh": 2,
        "includeAll": true,
        "multi": false,
        "allValue": ".+",
        "sort": 1,
        "current": {
          "selected": true,
          "text": "All",
          "value": "$__all"
        }
      }
    ]
  },
